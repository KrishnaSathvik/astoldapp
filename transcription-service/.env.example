# Copy to .env for local runs. NEVER commit a real key.
NODE_ENV=development
PORT=8787

# Leave OPENAI_API_KEY unset to use the built-in fake provider (no network).
# Set it (server-side only) to relay to the real OpenAI transcription API.
OPENAI_API_KEY=
# Chosen by benchmark, not by model recency (docs/benchmark/README.md).
TRANSCRIBE_MODEL=gpt-4o-transcribe
# Transcription instruction arm: punctuated (default) | strictVerbatim | terse — see src/prompt.ts.
TRANSCRIBE_PROMPT_VARIANT=punctuated

# Product limits (see docs/04-voice-transcription.md §7, §14).
MAX_AUDIO_BYTES=26214400          # 25 MB
MAX_DURATION_SECONDS=600          # 10 minutes

# Rate limiting (per attested install / IP). Redis-backed in production.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SECONDS=60

# App Attest: required in production; a dev bypass is allowed only when NODE_ENV != production.
APP_ATTEST_REQUIRED=false

# App Attest (production). Required when APP_ATTEST_REQUIRED=true.
APP_ATTEST_APP_ID=          # "TEAMID.bundleId", e.g. ABCDE12345.com.astold.app
APP_ATTEST_PRODUCTION=false # true = require the production AAGUID (release builds)
# Durable registry of attested keys + assertion counters. Required when APP_ATTEST_REQUIRED=true;
# must live on a mounted volume, or the counter resets on every restart and stops blocking replays.
APP_ATTEST_DB_PATH=         # e.g. /data/app-attest.db
# Escape hatch for a production relay deliberately left open (pre-launch staging only).
# With this unset, NODE_ENV=production + APP_ATTEST_REQUIRED=false refuses to boot.
APP_ATTEST_ALLOW_UNPROTECTED=false
