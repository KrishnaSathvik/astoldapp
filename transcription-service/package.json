{
  "name": "yourly-transcription-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Server-side relay that transcribes recordings via OpenAI so the app never holds the API key.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@peculiar/asn1-schema": "^2.9.0",
    "@peculiar/x509": "^2.0.0",
    "cbor-x": "^1.6.5",
    "fastify": "^5.2.1",
    "openai": "^4.77.0",
    "reflect-metadata": "^0.2.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
